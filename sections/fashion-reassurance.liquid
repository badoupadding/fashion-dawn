{%- if section.blocks.size > 0 -%}
  <div class="fashion-reassurance color-{{ section.settings.color_scheme }} gradient" style="--reassurance-space: {{ section.settings.padding }}px">
    <div class="page-width">
      {%- if section.settings.heading != blank -%}<h2 class="h2 center">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      <ul class="fashion-reassurance__list" role="list">
        {%- for block in section.blocks -%}
          {%- if block.settings.heading != blank -%}
            <li class="fashion-reassurance__item" {{ block.shopify_attributes }}>
              {%- if block.settings.icon != 'none' -%}{% render 'icon-accordion', icon: block.settings.icon %}{%- endif -%}
              <div><h3 class="h4">{{ block.settings.heading | escape }}</h3>
                {%- if block.settings.text != blank -%}<div class="rte">{{ block.settings.text }}</div>{%- endif -%}
                {%- if block.settings.link != blank and block.settings.label != blank -%}<a class="link" href="{{ block.settings.link }}">{{ block.settings.label | escape }}</a>{%- endif -%}
              </div>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- endif -%}
{% stylesheet %}
  .fashion-reassurance { padding-block: var(--reassurance-space); border-block: .1rem solid rgba(var(--color-foreground), .12); }
  .fashion-reassurance__list { display: flex; flex-wrap: wrap; gap: 2.4rem; padding: 0; margin: 0; list-style: none; }
  .fashion-reassurance__item { display: flex; align-items: flex-start; gap: 1.4rem; flex: 1 1 20rem; }
  .fashion-reassurance__item h3 { margin: 0 0 .4rem; }
  .fashion-reassurance__item .rte { font-size: 1.5rem; }
  .fashion-reassurance__item .rte p { margin: 0; }
  .fashion-reassurance__item .icon { width: 2.4rem; height: 2.4rem; flex-shrink: 0; margin-top: .4rem; }
  .fashion-reassurance__item .link { display: inline-block; padding-block: .8rem; }
{% endstylesheet %}
{% schema %}
{
  "name": "Service information",
  "tag": "section",
  "max_blocks": 4,
  "settings": [
    {"type":"text","id":"heading","label":"Heading"},
    {"type":"color_scheme","id":"color_scheme","label":"Colour scheme","default":"scheme-2"},
    {"type":"range","id":"padding","label":"Vertical padding","min":16,"max":64,"step":4,"unit":"px","default":28},
    {"type":"paragraph","content":"Add only service promises you can fulfil. Leave policy content blank until it is ready."}
  ],
  "blocks": [{"type":"service","name":"Service","settings":[
    {"type":"select","id":"icon","label":"Icon","options":[{"value":"none","label":"None"},{"value":"truck","label":"Delivery"},{"value":"return","label":"Returns"},{"value":"chat_bubble","label":"Support"},{"value":"ruler","label":"Sizing"},{"value":"check_mark","label":"Check"}],"default":"chat_bubble"},
    {"type":"text","id":"heading","label":"Heading","default":"Here to help"},
    {"type":"richtext","id":"text","label":"Text"},
    {"type":"text","id":"label","label":"Link label"},
    {"type":"url","id":"link","label":"Link"}
  ]}],
  "presets":[{"name":"Service information","blocks":[{"type":"service"}]}]
}
{% endschema %}
