{%- if section.settings.replacement_menu == blank -%}
  <nav class="fashion-navigation color-{{ section.settings.color_scheme }} gradient" aria-label="{{ section.settings.label | escape }}">
    <div class="page-width">
      <ul class="fashion-navigation__links" role="list">
        {%- for block in section.blocks -%}
          {%- if block.settings.link != blank and block.settings.label != blank -%}
            <li {{ block.shopify_attributes }}><a href="{{ block.settings.link }}">{{ block.settings.label | escape }}</a></li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </nav>
{%- endif -%}
{% stylesheet %}
  .fashion-navigation { border-bottom: .1rem solid rgba(var(--color-foreground), .12); }
  .fashion-navigation__links { display: flex; align-items: center; justify-content: center; gap: 2.8rem; padding: 0; margin: 0; list-style: none; }
  .fashion-navigation__links a { display: inline-flex; min-height: 4.8rem; align-items: center; color: rgb(var(--color-foreground)); font-size: 1.5rem; font-weight: 500; text-decoration: none; white-space: nowrap; }
  .fashion-navigation__links a:hover { text-decoration: underline; text-underline-offset: .4rem; }
  @media screen and (max-width: 749px) {
    .fashion-navigation__links { justify-content: flex-start; gap: 2.4rem; overflow-x: auto; }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "Fashion navigation",
  "tag": "section",
  "enabled_on": {"groups":["header"]},
  "max_blocks": 8,
  "settings": [
    {"type":"text","id":"label","label":"Accessible navigation label","default":"Shop navigation"},
    {"type":"color_scheme","id":"color_scheme","label":"Color scheme","default":"scheme-1"},
    {"type":"link_list","id":"replacement_menu","label":"Hide when this native menu exists","info":"Choose the same menu as the header to replace this starter navigation."}
  ],
  "blocks": [{"type":"link","name":"Navigation link","settings":[
    {"type":"text","id":"label","label":"Label","default":"Explore"},
    {"type":"url","id":"link","label":"Link"}
  ]}],
  "presets":[{"name":"Fashion navigation"}]
}
{% endschema %}
