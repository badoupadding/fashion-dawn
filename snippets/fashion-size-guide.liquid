{% doc %}
  Renders a native expandable size page only when a real page is configured.
  @param {object} block - The size guide block.
{% enddoc %}
{%- if block.settings.page != blank and block.settings.page.content != blank -%}
  <details class="fashion-size-guide" {{ block.shopify_attributes }}>
    <summary>{% render 'icon-accordion', icon: 'ruler' %}<span>{{ block.settings.label | escape }}</span>{{ 'icon-caret.svg' | inline_asset_content }}</summary>
    <div class="rte fashion-size-guide__content">{{ block.settings.page.content }}</div>
  </details>
{%- endif -%}
{% stylesheet %}
  .fashion-size-guide summary { display: flex; gap: 1rem; align-items: center; min-height: 4.8rem; font-size: 1.5rem; text-decoration: underline; text-underline-offset: .3rem; }
  .fashion-size-guide summary .icon { height: 1.8rem; width: 1.8rem; }
  .fashion-size-guide summary .icon-caret { margin-left: auto; }
  .fashion-size-guide__content { max-height: 40rem; overflow: auto; padding: 1.6rem 0; font-size: 1.5rem; }
{% endstylesheet %}
