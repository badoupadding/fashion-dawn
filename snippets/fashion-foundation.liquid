{% doc %}
  Applies the optional fashion reading and interaction defaults to native Dawn components.
{% enddoc %}
{% style %}
  :root {
    --fashion-control-height: {{ settings.fashion_control_height | default: 48 }}px;
    --fashion-product-title-size: {{ settings.fashion_product_title_size | default: 32 }}px;
  }
{% endstyle %}
{% stylesheet %}
  .fashion-theme { color: rgb(var(--color-foreground)); letter-spacing: .015em; }
  .fashion-theme h1, .fashion-theme h2, .fashion-theme .h0, .fashion-theme .h1, .fashion-theme .h2 { letter-spacing: -.025em; text-wrap: balance; }
  .fashion-theme .button, .fashion-theme .select__select, .fashion-theme .field__input, .fashion-theme .quantity { min-height: var(--fashion-control-height); }
  .fashion-theme .header__icon { min-height: 4.8rem; min-width: 4.8rem; }
  .fashion-theme .header__menu-item { font-size: 1.5rem; padding-block: 1.6rem; }
  .fashion-theme .product__title h1 { font-size: var(--fashion-product-title-size); line-height: 1.25; }
  .fashion-theme .product__info-container { line-height: 1.7; }
  .fashion-theme .product__info-container .price--large { font-size: 2.4rem; }
  .fashion-theme .product-form__input--pill input[type='radio'] + label { min-width: 4.8rem; min-height: var(--fashion-control-height); display: inline-flex; align-items: center; justify-content: center; font-size: 1.6rem; margin-right: .8rem; padding: 1rem 1.6rem; }
  .fashion-theme .product-form__input .form__label { font-size: 1.6rem; margin-bottom: 1rem; }
  .fashion-theme .product-form__input--swatch .swatch-input__label { --swatch-input--size: 4.8rem; }
  .fashion-theme .product__accordion summary { min-height: var(--fashion-control-height); padding-block: 1.6rem; }
  .fashion-theme .card__heading { font-size: 1.7rem; line-height: 1.45; }
  .fashion-theme .card-information { color: rgb(var(--color-foreground)); }
  .fashion-theme .card-information .price { font-size: 1.6rem; }
  .fashion-theme .card__information { padding-top: 1.6rem; }
  .fashion-theme .badge { font-size: 1.2rem; padding: .6rem 1rem; }
  .fashion-theme .facets__summary, .fashion-theme .facets__display, .fashion-theme .facet-checkbox { font-size: 1.5rem; }
  .fashion-theme .facet-checkbox { min-height: 4.8rem; align-items: center; }
  .fashion-theme .product-form__submit { font-weight: 600; }
  .fashion-theme .footer-block__details-content .list-menu__item--link { font-size: 1.5rem; padding-block: 1.2rem; }
  .fashion-theme :focus-visible { outline: .2rem solid currentColor; outline-offset: .4rem; }
  @media screen and (max-width: 749px) {
    .fashion-theme .field__input, .fashion-theme .select__select { font-size: 1.6rem; }
    .fashion-theme .product__title h1 { font-size: min(var(--fashion-product-title-size), 3rem); }
    .fashion-theme .card__heading { font-size: 1.6rem; }
    .fashion-theme .card-information .price { font-size: 1.5rem; }
    .fashion-theme .product__info-wrapper { padding-top: 2.4rem; }
  }
{% endstylesheet %}
