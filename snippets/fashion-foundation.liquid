{% doc %}
  Applies the optional fashion reading and interaction defaults to native Dawn components.
{% enddoc %}
{% style %}
  :root {
    --fashion-control-height: {{ settings.fashion_control_height | default: 48 }}px;
    --fashion-product-title-size: {{ settings.fashion_product_title_size | default: 32 }}px;
    --fashion-sale-color: {{ settings.fashion_sale_color | default: '#17633F' }};
    {%- if settings.heading_style == 'clean' -%}
      --font-body-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      --font-heading-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      --font-body-weight: 400;
      --font-body-weight-bold: 700;
      --font-heading-weight: 600;
    {%- endif -%}
  }
{% endstyle %}
{% stylesheet %}
  .fashion-theme { color: rgb(var(--color-foreground)); letter-spacing: .015em; }
  .fashion-theme h1, .fashion-theme h2, .fashion-theme .h0, .fashion-theme .h1, .fashion-theme .h2 { letter-spacing: -.025em; text-wrap: balance; }
  .fashion-theme .button, .fashion-theme .select__select, .fashion-theme .field__input, .fashion-theme .quantity { min-height: var(--fashion-control-height); }
  .fashion-theme .header__icon { min-height: 4.8rem; min-width: 4.8rem; }
  .fashion-theme .header__menu-item { font-size: 1.5rem; padding-block: 1.6rem; }
  .fashion-theme .product__title h1 { font-size: var(--fashion-product-title-size); line-height: 1.25; }
  .fashion-theme .product__info-container { line-height: 1.7; }
  .fashion-theme .product__info-container .price--large { font-size: 2.4rem; }
  .fashion-theme .product-form__input--pill input[type='radio'] + label { min-width: 4.8rem; min-height: var(--fashion-control-height); display: inline-flex; align-items: center; justify-content: center; font-size: 1.6rem; margin-right: .8rem; padding: 1rem 1.6rem; }
  .fashion-theme .product-form__input .form__label { font-size: 1.6rem; margin-bottom: 1rem; }
  .fashion-theme .product-form__input--swatch .swatch-input__label { --swatch-input--size: 4.8rem; }
  .fashion-theme .product__accordion summary { min-height: var(--fashion-control-height); padding-block: 1.6rem; }
  .fashion-theme .card__heading { font-size: 1.7rem; line-height: 1.45; }
  .fashion-theme .card-information { color: rgb(var(--color-foreground)); }
  .fashion-theme .card-information .price { font-size: 1.6rem; }
  .fashion-theme .card__information { padding-top: 1.6rem; }
  .fashion-theme .badge { font-size: 1.2rem; padding: .6rem 1rem; }
  .fashion-theme .facets__summary, .fashion-theme .facets__display, .fashion-theme .facet-checkbox { font-size: 1.5rem; }
  .fashion-theme .facet-checkbox { min-height: 4.8rem; align-items: center; }
  .fashion-theme .product-form__submit { font-weight: 600; }
  .fashion-theme .footer-block__details-content .list-menu__item--link { font-size: 1.5rem; padding-block: 1.2rem; }
  .fashion-theme :focus-visible { outline: .2rem solid currentColor; outline-offset: .4rem; }
  @media screen and (max-width: 749px) {
    .fashion-theme .field__input, .fashion-theme .select__select { font-size: 1.6rem; }
    .fashion-theme .product__title h1 { font-size: min(var(--fashion-product-title-size), 3rem); }
    .fashion-theme .card__heading { font-size: 1.6rem; }
    .fashion-theme .card-information .price { font-size: 1.5rem; }
    .fashion-theme .product__info-wrapper { padding-top: 2.4rem; }
  }
  .luxelette-editorial h1, .luxelette-editorial h2, .luxelette-editorial .h0, .luxelette-editorial .h1, .luxelette-editorial .h2, .luxelette-editorial .hxl {
    font-family: Georgia, 'Times New Roman', serif;
    font-weight: 400;
    letter-spacing: -.035em;
  }
  .luxelette-editorial .header__heading-link .h2 { font-size: 2.8rem; letter-spacing: .15em; text-transform: uppercase; }
  .luxelette-editorial .banner__box { max-width: 54rem; border: 0; }
  .luxelette-editorial .banner__text { line-height: 1.75; }
  .luxelette-editorial .rich-text__blocks { max-width: 72rem; }
  .luxelette-editorial .announcement-bar__message { font-size: 1.2rem; letter-spacing: .12em; }
  .luxelette-editorial .banner__heading { line-height: 1.08; }
  @media screen and (min-width: 990px) { .luxelette-editorial .banner__box { padding: 4.8rem; } }
  @media screen and (max-width: 749px) {
    .luxelette-editorial .header__heading-link .h2 { font-size: 2.4rem; }
    .luxelette-editorial .banner__box { padding: 3.2rem 2rem; }
  }
  .luxelette-clean { font-size: 1.65rem; line-height: 1.65; letter-spacing: normal; }
  .luxelette-clean h1, .luxelette-clean h2, .luxelette-clean h3, .luxelette-clean h4,
  .luxelette-clean .h0, .luxelette-clean .h1, .luxelette-clean .h2, .luxelette-clean .h3, .luxelette-clean .h4, .luxelette-clean .hxl {
    font-family: var(--font-heading-family);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -.01em;
  }
  .luxelette-clean .banner__heading { font-size: clamp(3.2rem, 4.6vw, 5.2rem); line-height: 1.15; }
  .luxelette-clean .banner__box { max-width: 58rem; border: 0; }
  .luxelette-clean .banner__text { font-size: 1.65rem; line-height: 1.65; }
  .luxelette-clean .rich-text__blocks { max-width: 68rem; }
  .luxelette-clean .rte { line-height: 1.7; }
  .luxelette-clean .product__description, .luxelette-clean .accordion__content { font-size: 1.65rem; }
  .luxelette-clean .header__heading-link .h2 { font-size: 2.6rem; font-weight: 600; letter-spacing: .06em; text-transform: none; }
  .luxelette-clean .header__menu-item, .luxelette-clean .footer-block__details-content .list-menu__item--link { font-size: 1.5rem; }
  .luxelette-clean .button { font-size: 1.6rem; font-weight: 600; letter-spacing: .01em; line-height: 1.4; padding-block: 1.2rem; white-space: normal; }
  .luxelette-clean .product__info-container .price--large { font-size: 2.4rem; font-weight: 600; font-variant-numeric: lining-nums; }
  .luxelette-clean .card__heading { font-size: 1.65rem; font-weight: 500; line-height: 1.5; letter-spacing: normal; }
  .luxelette-clean .card-information .price { font-size: 1.65rem; font-weight: 600; }
  .luxelette-clean .product__tax, .luxelette-clean .installment, .luxelette-clean .product__inventory,
  .luxelette-clean .cart__tax-note, .luxelette-clean .tax-note, .luxelette-clean .copyright__content { font-size: 1.4rem; line-height: 1.6; }
  .luxelette-clean .caption-with-letter-spacing, .luxelette-clean .announcement-bar__message { font-size: 1.3rem; letter-spacing: .03em; line-height: 1.6; }
  .luxelette-clean .field__input, .luxelette-clean .select__select { font-size: 1.6rem; }
  .luxelette-clean .field__input:focus, .luxelette-clean .field__input:not(:placeholder-shown) { font-size: 1.6rem; }
  .fashion-pdp .product__info-container > * + * { margin-block: 1.6rem; }
  .fashion-pdp .product__title { margin-bottom: 1rem; }
  .fashion-pdp .product__title h1 { font-size: clamp(2.6rem, 2.6vw, 3.2rem); font-weight: 600; line-height: 1.3; }
  .fashion-pdp .product-form__input { margin-block: 1.6rem; max-width: none; }
  .fashion-pdp .product-form__buttons { max-width: none; }
  .fashion-pdp .product-form__submit { min-height: 5.6rem; font-size: 1.7rem; }
  .fashion-pdp .product-form { margin-block: 2rem 1.2rem; }
  .fashion-pdp .product__accordion { margin-block: 0; }
  .fashion-pdp .accordion__content { overflow-wrap: anywhere; }
  .fashion-pdp .accordion__content img { max-width: 100%; height: auto; }
  .fashion-pdp .product__media-list { margin-bottom: 1.2rem; }
  .fashion-pdp .thumbnail { border-color: rgba(var(--color-foreground), .3); }
  .fashion-pdp .thumbnail[aria-current='true'] { border-color: rgb(var(--color-foreground)); }
  @media screen and (min-width: 990px) { .fashion-pdp .product__info-wrapper { padding-left: 4rem; } }
  @media screen and (min-width: 990px) { .luxelette-clean .banner__box { padding: 4.8rem; } }
  @media screen and (max-width: 749px) {
    .luxelette-clean .header__heading-link .h2 { font-size: 2.3rem; }
    .luxelette-clean .banner__box { padding: 3.2rem 2rem; }
    .luxelette-clean .rich-text__blocks { text-align: left; }
    .luxelette-clean .card__heading, .luxelette-clean .card-information .price { font-size: 1.5rem; }
  }
{% endstylesheet %}
