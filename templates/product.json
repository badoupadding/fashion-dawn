{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "title": {
          "type": "title"
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": false,
            "show_gift_card_recipient": false,
            "fashion_show_price": true
          }
        },
        "description": {
          "type": "description"
        },
        "fit": {
          "type": "fashion_note",
          "settings": {
            "icon": "ruler",
            "heading": "",
            "text": ""
          }
        },
        "service": {
          "type": "fashion_note",
          "settings": {
            "icon": "truck",
            "heading": "",
            "text": ""
          }
        },
        "summary": {
          "type": "fashion_summary",
          "settings": {
            "text": "",
            "use_description": true
          }
        },
        "size_guide": {
          "type": "fashion_size_guide",
          "settings": {
            "label": "Size guide"
          }
        },
        "rating": {
          "type": "rating"
        },
        "inventory": {
          "type": "inventory",
          "settings": {
            "text_style": "body",
            "inventory_threshold": 5,
            "show_inventory_quantity": true,
            "sale_message": "Sale ends when sold out.",
            "confirm_untracked_stock": true,
            "untracked_message": "Limited stock \u2014 sale ends when sold out."
          }
        },
        "checkout_trust": {
          "type": "fashion_checkout_trust",
          "settings": {
            "secure_label": "Secure checkout",
            "show_payments": true,
            "contact_label": "Questions before ordering? Contact us",
            "contact_url": "shopify://pages/contact"
          }
        }
      },
      "block_order": [
        "title",
        "rating",
        "price",
        "summary",
        "variant_picker",
        "size_guide",
        "fit",
        "inventory",
        "buy_buttons",
        "checkout_trust",
        "service",
        "description"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "thumbnail_slider",
        "media_size": "medium",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "show",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 24,
        "padding_bottom": 32,
        "fashion_sticky_options": true,
        "fashion_purchase_layout": true,
        "fashion_description_accordion": true
      }
    },
    "disclosures": {
      "type": "disclosures",
      "settings": {
        "padding_top": 36,
        "padding_bottom": 0
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "You may also like",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "portrait",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 32,
        "padding_bottom": 32
      }
    }
  },
  "order": [
    "main",
    "disclosures",
    "related-products"
  ]
}
