{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "title": {
          "type": "title"
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": false,
            "show_gift_card_recipient": false
          }
        },
        "description": {
          "type": "description"
        },
        "fit": {
          "type": "fashion_note",
          "settings": {
            "icon": "ruler",
            "heading": "",
            "text": ""
          }
        },
        "service": {
          "type": "fashion_note",
          "settings": {
            "icon": "truck",
            "heading": "",
            "text": ""
          }
        },
        "summary": {
          "type": "fashion_summary",
          "settings": {
            "text": "",
            "use_description": true
          }
        },
        "size_guide": {
          "type": "fashion_size_guide",
          "settings": {
            "label": "Size guide"
          }
        },
        "purchase_info": {
          "type": "fashion_purchase_info",
          "settings": {
            "show_policies": true,
            "show_payments": true
          }
        },
        "rating": {
          "type": "rating"
        }
      },
      "block_order": [
        "title",
        "rating",
        "price",
        "summary",
        "variant_picker",
        "size_guide",
        "fit",
        "buy_buttons",
        "purchase_info",
        "service",
        "description"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "thumbnail_slider",
        "media_size": "medium",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "show",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 24,
        "padding_bottom": 32,
        "fashion_sticky_options": true,
        "fashion_purchase_layout": true,
        "fashion_description_accordion": true
      }
    },
    "disclosures": {
      "type": "disclosures",
      "settings": {
        "padding_top": 36,
        "padding_bottom": 0
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "You may also like",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "portrait",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 32,
        "padding_bottom": 32
      }
    },
    "campaign_story": {
      "type": "rich-text",
      "blocks": {
        "heading": {
          "type": "heading",
          "settings": {
            "heading": "A closer look",
            "heading_size": "h1"
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>Use this space for the product’s fit, fabric and everyday styling details.</p>"
          }
        }
      },
      "block_order": [
        "heading",
        "text"
      ],
      "settings": {
        "color_scheme": "scheme-2",
        "padding_top": 48,
        "padding_bottom": 48
      },
      "disabled": true
    }
  },
  "order": [
    "main",
    "campaign_story",
    "disclosures",
    "related-products"
  ]
}
